  "validations": [
    {
      "id": "npoo-up-share",
      "severity": "error",
      "rule": "sum(UP) > 0.10 * sum(direct)",
      "message": "Upravljanje projektom prelazi 10 % izravnih troškova."
    },
    {
      "id": "npoo-end-date",
      "severity": "error",
      "rule": "project.endDate > 2026-06-30",
      "message": "Završetak projekta nakon 30. 6. 2026. – provjeriti rok poziva (RRF krajnji rok 31. 8. 2026.)."
    },
    {
      "id": "npoo-vat",
      "severity": "warning",
      "rule": "expense.vatIncluded && beneficiary.vatRecoverable",
      "message": "PDV nije prihvatljiv trošak ako ga korisnik može odbiti."
    },
    {
      "id": "npoo-indirect-default",
      "severity": "info",
      "rule": "package.extends == null",
      "message": "Stopa neizravnih troškova (15 % osoblja) je zadana vrijednost programskog okvira – potvrdi je prema Uputama za prijavitelje poziva."
    }
  ]
