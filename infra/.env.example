# Kopirati u apps/api/.env (nije u gitu)
PORT=3000
# aplikacijska uloga (bez BYPASSRLS) – stvara je migracija 0001
DATABASE_URL=postgresql://arqus_app:arqus@localhost:5432/arqus
# vlasnička uloga – samo za migracije i seed
DATABASE_MIGRATE_URL=postgresql://arqus:arqus@localhost:5432/arqus
# tajna za potpisivanje JWT-a (obvezno u produkciji), trajanje tokena
AUTH_JWT_SECRET=promijeni-me-u-dugu-nasumicnu-vrijednost
AUTH_TOKEN_TTL=8h
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=arqus
S3_SECRET_KEY=arqus-minio
S3_BUCKET=arqus-dokumenti
ARQUS_PACKAGES_DIR=../../docs/domena/paketi
