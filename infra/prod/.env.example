# Kopirati u infra/prod/.env (nije u gitu) i popuniti jakim nasumičnim vrijednostima (npr. openssl rand -base64 36).
# Cijelu popunjenu .env datoteku čuvati i IZVAN poslužitelja (upravitelj lozinki) – bez nje (osobito BACKUP_ENCRYPTION_KEY
# i MFA_ENCRYPTION_KEY) obnova na novom poslužitelju nije potpuna (docs/PILOT-INSTALACIJA.md, odj. 4).
DOMAIN=pilot.example.hr
ACME_EMAIL=admin@example.hr
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=8h
# ključ za šifriranje MFA tajni u bazi (zaseban od JWT tajne; promjena ključa poništava postavljene MFA-ove)
MFA_ENCRYPTION_KEY=
# uvoz globalnih poziva s portala EU Funding & Tenders svakih N sati (0 = isključeno; treba izlazni HTTPS prema api.tech.ec.europa.eu)
FT_IMPORT_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=3600

# --- Pohrana dokumenata (ADR-0010, WP1.20) ---------------------------------------------------------------
# local (zadano) = Docker volumen `documents`; s3 = S3-kompatibilan bucket u EU (prije prelaska: documents migrate --to s3)
DOCUMENTS_STORAGE=local
# adresa S3 usluge pružatelja (https://…); regija prema pružatelju (npr. hr-zag-1, eu-central-1)
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_REGION=
DOCUMENTS_S3_BUCKET=
# ključ s pravima samo na ovaj bucket (čitanje, pisanje, popis, brisanje); ne dijeliti s bucketom za kopije
DOCUMENTS_S3_ACCESS_KEY_ID=
DOCUMENTS_S3_SECRET_ACCESS_KEY=
# true = https://endpoint/bucket/kljuc (većina pružatelja, MinIO); false = https://bucket.endpoint/kljuc
DOCUMENTS_S3_FORCE_PATH_STYLE=true
# neobavezno: prefiks ključeva (npr. pilot/) ako bucket dijeli više instalacija
DOCUMENTS_S3_PREFIX=
# neobavezno: zaglavlje x-amz-server-side-encryption (npr. AES256) ako pružatelj šifriranje na strani poslužitelja ne radi sam
DOCUMENTS_S3_SSE=
# neobavezno: drugi bucket za kopiju dokumenata (documents migrate --to mirror); ista značenja kao iznad
DOCUMENTS_MIRROR_S3_ENDPOINT=
DOCUMENTS_MIRROR_S3_REGION=
DOCUMENTS_MIRROR_S3_BUCKET=
DOCUMENTS_MIRROR_S3_ACCESS_KEY_ID=
DOCUMENTS_MIRROR_S3_SECRET_ACCESS_KEY=

# --- Kopije izvan poslužitelja (WP1.20, ADR-0012) ----------------------------------------------------------
# Uključivanje: COMPOSE_PROFILES=offsite (pokreće servis `offsite`). Bez toga instalacija radi bez kopija izvan poslužitelja.
COMPOSE_PROFILES=
# ključ za šifriranje kopija: openssl rand -base64 32 – NIKAD ga ne mijenjati bez nove pune kopije; izgubljen ključ = izgubljene kopije
BACKUP_ENCRYPTION_KEY=
# bucket za kopije – po mogućnosti kod drugog pružatelja ili u drugoj zoni; ključ s pravima samo na taj bucket
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_PREFIX=
# koliko dana se čuvaju kopije u bucketu (najnovija kopija baze i arhiva dokumenata ostaju uvijek)
BACKUP_OFFSITE_RETENTION_DAYS=30
# koliko često se novi lokalni backupi šalju (sekunde)
BACKUP_OFFSITE_INTERVAL_SECONDS=900
# servis offsite je "unhealthy" kad je zadnja uspješna sinkronizacija ili najnovija kopija baze izvan poslužitelja starija od ovoga
BACKUP_OFFSITE_MAX_AGE_HOURS=3
