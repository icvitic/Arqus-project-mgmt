{
  "name": "arqus-projekti",
  "version": "0.8.0",
  "private": true,
  "description": "ArQus Projekti – SaaS/PaaS platforma za životni ciklus EU i nacionalnih projekata",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @arqus/domain build && pnpm -r typecheck",
    "test": "pnpm --filter @arqus/domain build && pnpm -r test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.21.0",
    "globals": "^15.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "type": "module"
}
